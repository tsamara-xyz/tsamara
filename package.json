{
  "name": "tsamara",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "!apps/docs",
    "!apps/video",
    "contracts"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "demo": "bun apps/devnet-demo/lifecycle.ts",
    "api": "bun apps/api/index.ts",
    "app": "bun run --cwd apps/app dev",
    "indexer": "cargo run --release --manifest-path apps/indexer/Cargo.toml --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "typescript": "^5"
  }
}
